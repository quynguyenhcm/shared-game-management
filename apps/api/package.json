{
  "name": "@sgm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(api|worker)$/\"",
    "dev:api": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/worker.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@fastify/otel": "^0.21.0",
    "@fastify/swagger": "^9.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sgm/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1"
  }
}
