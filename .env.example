# Copy to .env via `pnpm run setup` (generates ENCRYPTION_KEYS). All values below are non-secret placeholders.

NODE_ENV=development
SERVICE_VERSION=0.0.0-dev
API_PORT=4000
WORKER_HEALTH_PORT=4001

# PostgreSQL 17 (docker compose service `postgres`, published on 5432)
DATABASE_URL=postgres://sgm:sgm@localhost:5432/sgm
DATABASE_POOL_MAX=10

# Keyring: "<id>:<base64 of 32 bytes>[,<id>:<base64>...]". `pnpm run setup` replaces the placeholder.
ENCRYPTION_KEYS=<generated-by-setup>
ENCRYPTION_ACTIVE_KEY_ID=dev1

# Notifications: smtp (Mailpit in dev) or memory (tests)
NOTIFIER_ADAPTER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Shared Game Management <no-reply@example.test>
MAILPIT_API_URL=http://localhost:8025

# Job runner tuning (optional). The expiry override exists for tests only: leave it unset.
JOBS_SUPERVISE_INTERVAL_SECONDS=60
JOBS_POLL_INTERVAL_SECONDS=2
# JOBS_EXPIRE_SECONDS_OVERRIDE=5

# Server-side URL the web app uses to reach the API
API_INTERNAL_URL=http://localhost:4000

# Authentication (auth-and-user-roles). Validated at boot by both apps; see docs/getting-started.md.
# Public origin of the web app (http(s), no path). https is required in production
# (the web app alone allows a localhost host there).
WEB_BASE_URL=http://localhost:3000
# Google / Facebook sign-in: set both variables of a provider or neither (neither = provider disabled).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_APP_ID=
# FACEBOOK_OAUTH_APP_SECRET=
# Fake Google/Facebook providers for E2E (`pnpm run test:e2e`). Refused when NODE_ENV=production.
AUTH_FAKE_OAUTH=false
# Session lifetime (days), reset-link lifetime (minutes) and sign-in throttling (defaults shown).
AUTH_SESSION_IDLE_DAYS=7
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_RESET_TOKEN_MINUTES=60
AUTH_LOGIN_MAX_FAILURES_PER_EMAIL=5
AUTH_LOGIN_MAX_FAILURES_PER_ADDRESS=20
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_FORGOT_MAX_PER_ADDRESS=10
AUTH_REGISTER_MAX_PER_ADDRESS=20
# Shared by the api and the web (at least 32 characters, same value on both). Authenticates the web-to-API hop
# that carries the client address. REQUIRED in production. This is a dev-only placeholder: never reuse it.
API_INTERNAL_SHARED_SECRET=dev-only-internal-secret-change-me-0123456789
# Number of reverse proxies in front of the web app that append to X-Forwarded-For (0 to 5; web only).
# REQUIRED in production; 0 is allowed there only for a localhost WEB_BASE_URL.
WEB_TRUSTED_PROXY_HOPS=0

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout
# LOG_FILE_PATH=./logs/sgm.log
LOG_REDACT_PATTERNS=password,secret,token,apiKey

# Observability (OTEL_SERVICE_NAME is set per process, not here)
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_ENABLED=false
METRICS_PORT=9090
METRICS_PATH=/metrics
