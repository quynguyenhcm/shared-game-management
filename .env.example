# Copy to .env via `pnpm run setup` (generates ENCRYPTION_KEYS). All values below are non-secret placeholders.

NODE_ENV=development
SERVICE_VERSION=0.0.0-dev
API_PORT=4000
WORKER_HEALTH_PORT=4001

# PostgreSQL 17 (docker compose service `postgres`, published on 5432)
DATABASE_URL=postgres://sgm:sgm@localhost:5432/sgm
DATABASE_POOL_MAX=10

# Keyring: "<id>:<base64 of 32 bytes>[,<id>:<base64>...]". `pnpm run setup` replaces the placeholder.
ENCRYPTION_KEYS=<generated-by-setup>
ENCRYPTION_ACTIVE_KEY_ID=dev1

# Notifications: smtp (Mailpit in dev) or memory (tests)
NOTIFIER_ADAPTER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Shared Game Management <no-reply@example.test>
MAILPIT_API_URL=http://localhost:8025

# Job runner tuning (optional). The expiry override exists for tests only: leave it unset.
JOBS_SUPERVISE_INTERVAL_SECONDS=60
JOBS_POLL_INTERVAL_SECONDS=2
# JOBS_EXPIRE_SECONDS_OVERRIDE=5

# Server-side URL the web app uses to reach the API
API_INTERNAL_URL=http://localhost:4000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout
# LOG_FILE_PATH=./logs/sgm.log
LOG_REDACT_PATTERNS=password,secret,token,apiKey

# Observability (OTEL_SERVICE_NAME is set per process, not here)
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_ENABLED=false
METRICS_PORT=9090
METRICS_PATH=/metrics
